# Firebase client config (set NEXT_PUBLIC_* for browser access)
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-ghanneli.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-ghanneli

# Point to the Firebase Auth Emulator when running locally.
# Remove or leave blank to use production Firebase.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://localhost:9099

# --- Server-side (already set in docker-compose / .env.local) ---
# DATABASE_URL=...
# FIREBASE_PROJECT_ID=demo-ghanneli
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# REDIS_URL=...
# R2_BUCKET=...
# R2_ENDPOINT=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# STRIPE_SECRET_KEY=...
# STRIPE_WEBHOOK_SECRET=...
# ANTHROPIC_API_KEY=...
