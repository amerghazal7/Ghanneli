# =============================================================================
# Ghanneli â€” local dev environment (copy to .env.local and fill in secrets)
#
#   cp .env.local.example .env.local
#
# Items marked FILL_IN require a real value before `docker compose up --build`.
# Items marked PLACEHOLDER are pre-filled for the local docker-compose stack.
# =============================================================================

# ---------------------------------------------------------------------------
# Node
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (Postgres via local Neon HTTP proxy)
# PLACEHOLDER â€” matches the postgres service in docker-compose.yml
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://ghanneli:ghanneli@postgres:5432/ghanneli

# NEON_LOCAL_PROXY_URL routes the neon-http driver at the local proxy so the
# same driver code works locally as in prod. The proxy speaks HTTP on :4444.
NEON_LOCAL_PROXY_URL=http://neon-proxy:4444/sql

# ---------------------------------------------------------------------------
# Firebase Auth
# With FIREBASE_AUTH_EMULATOR_HOST set, firebase-admin automatically talks to
# the local emulator â€” no real Firebase project credentials are needed.
# Use a demo- project id (emulator accepts any demo- prefix).
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=demo-ghanneli
FIREBASE_CLIENT_EMAIL=local@demo-ghanneli.iam.gserviceaccount.com
# PLACEHOLDER private key â€” the emulator does not validate it.
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nPLACEHOLDER\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_AUTH_EMULATOR_HOST=firebase-emulator:9099

# ---------------------------------------------------------------------------
# Pub/Sub analytics (best-effort / no-op locally)
# Pub/Sub emit failures are swallowed in production code, so analytics events
# are simply dropped locally. This is expected and documented.
# To enable locally, add a pubsub emulator service and set the full topic path.
# ---------------------------------------------------------------------------
PUBSUB_PROJECT=demo-ghanneli
PUBSUB_TOPIC=analytics-events

# ---------------------------------------------------------------------------
# Queue â€” use BullMQ locally (prod uses Cloud Tasks)
# ---------------------------------------------------------------------------
QUEUE_DRIVER=bullmq
REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# Stripe (test-mode)
# FILL_IN â€” get your test keys from https://dashboard.stripe.com/test/apikeys
# Use `stripe listen --forward-to localhost:3000/api/webhooks/stripe` for webhooks.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_FILL_IN_YOUR_STRIPE_TEST_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_FILL_IN_YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# ---------------------------------------------------------------------------
# Object storage â€” MinIO (replaces Cloudflare R2 locally)
# PLACEHOLDER â€” matches the minio service in docker-compose.yml.
# R2_ENDPOINT triggers the forcePathStyle path in createProdR2Client().
# R2_PUBLIC_BASE_URL is the browser-reachable URL for audio preview/download.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=ghanneli-local
R2_PUBLIC_BASE_URL=http://localhost:9000/ghanneli-local
R2_ENDPOINT=http://minio:9000

# ---------------------------------------------------------------------------
# Audio post-processing
# Path to the watermark mp3 inside the worker container.
# The Dockerfile.worker copies app/assets/watermark.mp3 to this path.
# ---------------------------------------------------------------------------
WATERMARK_ASSET_PATH=/workspace/app/assets/watermark.mp3

# ---------------------------------------------------------------------------
# Music engine â€” fake GPU engine (LOCAL.4)
# ENGINE_MODE=self-host-staging routes to the self-host adapter.
# AIBACKEND_URL + AIBACKEND_TOKEN must match the fake-engine service.
# ---------------------------------------------------------------------------
ENGINE_MODE=self-host-staging
AIBACKEND_URL=http://fake-engine:9000
AIBACKEND_TOKEN=devtoken

# CLOUD_ENGINE_URL and CLOUD_ENGINE_TOKEN are NOT needed in self-host-staging
# mode (loadMusicConfigFromEnv only requires self-host vars in that mode).
# Leave blank or omit entirely.
# CLOUD_ENGINE_URL=
# CLOUD_ENGINE_TOKEN=

# ---------------------------------------------------------------------------
# Anthropic API â€” REAL key required for lyrics generation
# FILL_IN â€” get your key from https://console.anthropic.com/
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-FILL_IN_YOUR_REAL_ANTHROPIC_API_KEY

# Lyrics model â€” recorded as songs.lyricsModel provenance on every generated song.
# Prod should set this to the current Claude model; defaults to claude-3-5-haiku-latest.
# Example: LYRICS_MODEL=claude-3-5-haiku-latest
LYRICS_MODEL=claude-3-5-haiku-latest

# ---------------------------------------------------------------------------
# Music engine â€” REAL ACE-Step 1.5 (LOCAL GPU, OpenAI-compatible API)
# Set ENGINE_MODE=acestep-local to route generation to a locally-running ACE-Step.
# ACESTEP_URL: use http://127.0.0.1:8001 when web/worker run on the host,
#              or http://host.docker.internal:8001 when running inside Docker.
# ACESTEP_TOKEN: optional Bearer token (omit if ACE-Step has no auth configured).
# ACESTEP_MODEL: optional model override (omit to use the server default).
# ---------------------------------------------------------------------------
# ENGINE_MODE=acestep-local
# ACESTEP_URL=http://127.0.0.1:8001
# ACESTEP_TOKEN=
# ACESTEP_MODEL=

# ---------------------------------------------------------------------------
# Prod-only vars (NOT needed locally â€” documented here for reference)
#
# CLOUD_TASKS_PROJECT   â€” GCP project for Cloud Tasks (prod queue driver)
# CLOUD_TASKS_LOCATION  â€” GCP region for Cloud Tasks
# CLOUD_TASKS_QUEUE     â€” Cloud Tasks queue name
# WORKER_URL            â€” Cloud Run URL for the worker push route
# WORKER_SERVICE_ACCOUNT â€” Service account email for Cloud Tasks â†’ Cloud Run
#
# These are ignored when QUEUE_DRIVER=bullmq. Do not set locally.
# ---------------------------------------------------------------------------

